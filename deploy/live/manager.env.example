ENVIRONMENT=production
AUTHORIZED_TOKENS__pod=CHANGE_ME_POD_TOKEN
AUTHORIZED_TOKENS__runners=CHANGE_ME_RUNNER_TOKEN
# Administration; see manager/docs/LIVE_INSTALLATION.md#docker-compose-shortcut.
#  - ADMIN_USERS__admin: bcrypt password hash for the admin account; no default
#    Keep single quotes around the generated hash so Compose preserves dollar signs.
#  - MANAGER_PUBLIC_URL: browser-facing Manager URL, including the published port
ADMIN_USERS__admin='CHANGE_ME_BCRYPT_HASH'
MANAGER_PUBLIC_URL=http://127.0.0.1:8081
# Automatic RTMP-to-HLS discovery; see manager/docs/LIVE.md.
#  - LIVE_AUTO_START: watch RTMP publications and allocate available Live Runners (default: true)
#  - LIVE_AUTO_ETAB_NAME: fallback establishment for automatic session statistics (default: unknown)
LIVE_AUTO_START=true
LIVE_AUTO_ETAB_NAME=Live
#  - LIVE_SOURCES: optional broadcaster/path declarations, not an allowlist (default: {})
#    Each ID must match the final RTMP path component (the public broadcaster name).
# LIVE_SOURCES={"amphi-a":"live/amphi-a"}
LIVE_MEDIAMTX_API_USER=control
LIVE_MEDIAMTX_API_PASSWORD=CHANGE_ME_CONTROL_PASSWORD
LOG_DIR=/var/log/esup-runner
