# Example configuration for Esup-Runner Runner
# Copy to .env and adapt to your environment.
#
#   cp .env.example .env
#   nano .env
#   uv run scripts/check_config.py

# Optional Unix account that owns runtime directories and runs the systemd user service.
# SERVICE_USER=esup-runner

# DEBUG mode
DEBUG=false

# Runner/Multi-instance configuration
RUNNER_PROTOCOL=http
RUNNER_HOST=127.0.0.1
RUNNER_BASE_PORT=8082
RUNNER_BASE_NAME=my-runner

# Runner/Multi-instance configuration
# With grouped syntax in RUNNER_TASK_TYPES, the total number of instances is derived automatically.
# (You may keep RUNNER_INSTANCES, but it should match the computed total to avoid a warning.)
RUNNER_INSTANCES=1
# Task types managed by this runner
# Legacy syntax: encoding,studio,transcription (applies to all instances)
# Grouped syntax: [2x(encoding,studio,transcription),1x(encoding,studio),1x(transcription)]
RUNNER_TASK_TYPES=[1x(encoding,studio,transcription)]

# Monitor instances and automatically restart failed ones
RUNNER_MONITORING=false

# Private Manager API URL used by this Runner.
# It must use MANAGER_PROTOCOL/HOST/PORT from the Manager, never MANAGER_PUBLIC_URL.
MANAGER_URL=http://127.0.0.1:8081

# API token authentication
# - RUNNER_TOKEN: must match an authorised token in the manager
#   (and is also used to validate manager calls to this runner after registration)
RUNNER_TOKEN=CHANGE_ME_RUNNERS_TOKEN

# CORS (Runner API)
# Comma-separated list; keep "*" only if CORS_ALLOW_CREDENTIALS=false.
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# Outbound downloads (sources/assets)
# - DOWNLOAD_ALLOWED_HOSTS: optional allowlist (comma-separated). Empty means allow any.
# - DOWNLOAD_ALLOW_PRIVATE_NETWORKS: keep true for internal deployments; set false to mitigate SSRF to RFC1918/loopback.
DOWNLOAD_ALLOWED_HOSTS=
DOWNLOAD_ALLOW_PRIVATE_NETWORKS=true

# Media safety
# - MEDIA_CODEC_DENYLIST: comma-separated codec denylist checked before FFmpeg/ffprobe/Whisper.
#   Default denies MagicYUV while CVE-2026-8461 / PixelSmash is handled.
#   Set to an empty value only if you accept the related FFmpeg risk.
MEDIA_CODEC_DENYLIST=magicyuv

# Optional email/SMTP notifications (if enabled by your deployment)
#  - SMTP_SERVER: address of the SMTP server (e.g., smtp.example.org)
#  - SMTP_PORT: port of the SMTP server (e.g., 25 or 587)
#  - SMTP_USE_TLS: enable STARTTLS for encrypted SMTP connection (true/false)
#  - SMTP_USERNAME: SMTP authentication username (optional)
#  - SMTP_PASSWORD: SMTP authentication password (optional)
#  - SMTP_SENDER: email address used as sender for notifications
#  - MANAGER_EMAIL: email address of the manager to receive notifications
# SMTP_SERVER=smtp.example.org
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_SENDER=esup-runner@example.org
# MANAGER_EMAIL=admin@example.org

# Logs
# Legacy alias still supported: LOG_DIRECTORY
LOG_DIR=/var/log/esup-runner
LOG_LEVEL=INFO

# Workspace and storage configuration
#  - STORAGE_DIR: directory for temporary files during processing (make sure it has enough space and proper permissions)
#  - MAX_VIDEO_SIZE_GB: maximum video size in GB for processing (0 for unlimited)
#  - MAX_FILE_AGE_DAYS: maximum age of files in storage in days (0 for unlimited)
#  - CLEANUP_INTERVAL_HOURS: interval for periodic cleanup in hours
#  - EXTERNAL_SCRIPT_TIMEOUT_SECONDS: timeout for external task scripts (encoding/studio/transcription), default 18000 (5h)
STORAGE_DIR=/tmp/esup-runner
MAX_VIDEO_SIZE_GB=0
MAX_FILE_AGE_DAYS=7
CLEANUP_INTERVAL_HOURS=24
EXTERNAL_SCRIPT_TIMEOUT_SECONDS=18000

# Encoding type (CPU or GPU): set to GPU to enable GPU encoding (make sure your system is properly configured with NVIDIA drivers and CUDA)
ENCODING_TYPE=CPU

# Specifics settings for GPU encoding
# - GPU_CUDA_VISIBLE_DEVICES: specify which GPUs to use for encoding (e.g., 0,1 for the first two GPUs)
# - GPU_CUDA_DEVICE_ORDER: specify the order of devices (e.g., PCI_BUS_ID to order by PCI bus ID)
# - GPU_CUDA_PATH: specify the path to CUDA installation if not in default location (e.g., /usr/local/cuda-13.2)
# GPU_CUDA_VISIBLE_DEVICES=0
# GPU_CUDA_DEVICE_ORDER=PCI_BUS_ID
# GPU_CUDA_PATH=/usr/local/cuda-13.2

# Default encoding settings for STUDIO tasks
#  - STUDIO_DEFAULT_CRF: Compression rate factor (CRF) for video encoding
#  - STUDIO_DEFAULT_PRESET: Preset for video encoding (ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow)
#  - STUDIO_DEFAULT_AUDIO_BITRATE: Audio bitrate for audio encoding
STUDIO_DEFAULT_CRF=20
STUDIO_DEFAULT_PRESET=slow
STUDIO_DEFAULT_AUDIO_BITRATE=192k

# Transcription (Whisper) settings
# - WHISPER_MODEL: Whisper model to use for transcription (tiny, base, small, medium, large, turbo)
# - CACHE_DIR: Shared cache root used for Whisper, Hugging Face, and uv caches (default: /home/<SERVICE_USER>/.cache/esup-runner)
# - WHISPER_MODELS_DIR: Optional override (default: CACHE_DIR/whisper-models)
# - HUGGINGFACE_MODELS_DIR: Optional override (default: CACHE_DIR/huggingface)
# - UV_CACHE_DIR: Optional override for uv package cache (default: CACHE_DIR/uv)
# - HF_TOKEN: Optional Hugging Face token for higher rate limits / faster model downloads
# - WHISPER_LANGUAGE: final subtitle language (`auto` keeps the detected spoken language;
#   `fr` or `en` can trigger subtitle translation after transcription when needed)
# - WHISPER_CHUNK_THRESHOLD_SECONDS: optional advanced override for the automatic chunking threshold
#   (default: 800 on CPU runners, 1800 on GPU runners)
WHISPER_MODEL=turbo
# CACHE_DIR=/home/esup-runner/.cache/esup-runner
# WHISPER_MODELS_DIR=/home/esup-runner/.cache/esup-runner/whisper-models
# HUGGINGFACE_MODELS_DIR=/home/esup-runner/.cache/esup-runner/huggingface
# UV_CACHE_DIR=/home/esup-runner/.cache/esup-runner/uv
# HF_TOKEN=hf_xxx
WHISPER_LANGUAGE=auto
# WHISPER_CHUNK_THRESHOLD_SECONDS=900

# Optional Live streaming (see docs/LIVE.md and docs/MEDIAMTX_SETUP.md)
# Include live in RUNNER_TASK_TYPES above, e.g. [1x(encoding,studio),2x(live)].
# Run from runner/: uv run scripts/configure_live.py
# The helper fills these three installation-specific MediaMTX/RTMP credentials;
# all Live workers share them.
#  - LIVE_MEDIAMTX_API_PASSWORD: Runner MediaMTX control password
#  - LIVE_UPSTREAM_RTMP_URL: Manager RTMP URL with relay credentials (URL-encoded)
#  - LIVE_LOCAL_RTMP_URL: local Runner RTMP URL with transcoder credentials (URL-encoded)
# LIVE_MEDIAMTX_API_PASSWORD=filled-by-configure-live
# LIVE_UPSTREAM_RTMP_URL=rtmp://relay:CHANGE_ME_RELAY_PASSWORD@manager:1935
# LIVE_LOCAL_RTMP_URL=rtmp://transcoder:CHANGE_ME_READ_PASSWORD@127.0.0.1:2935

# Optional Esup-Pod broadcaster synchronization.
#  - LIVE_POD_URL: Pod API URL (e.g., https://pod.univ.fr)
#  - LIVE_POD_USERNAME: Pod API username
#  - LIVE_POD_PASSWORD: Pod API password
#    These 3 parameters must be configured together; the account needs permission
#    to GET /rest/broadcasters/?source_id=<identifier> and PATCH the matching
#    /rest/broadcasters/<slug>/. Requires Pod 4.5.0's Live source identifier field
#    and source_id filter; the source identifier can differ from the Pod slug.
#  - LIVE_POD_ESTABLISHMENT_NAME is an optional exact filter on task.etab_name. Set
#    it to the establishment served by this Pod when the Runner is shared by several
#    establishments; a different Live causes no request to this Pod. Leave it empty
#    or unset for a single-establishment Runner where this Pod serves every Live.
# LIVE_POD_URL=https://pod.univ.fr
# LIVE_POD_USERNAME=CHANGE_ME_POD_API_USERNAME
# LIVE_POD_PASSWORD=CHANGE_ME_POD_API_PASSWORD
# LIVE_POD_ESTABLISHMENT_NAME=University of xxx

# Optional hardware, quality or deployment choices; leave defaults out of .env.
#  - LIVE_TRANSCODER: cpu (libx264) or nvenc (NVIDIA), independent of ENCODING_TYPE (default: cpu)
#  - LIVE_CPU_FALLBACK: retry on CPU after GPU failure (default: true)
#  - LIVE_NVDEC: enable NVIDIA decoding in nvenc mode; ignored in cpu mode (default: false)
#  - LIVE_VARIANTS: optional JSON list of 2-16 renditions; names, even width/height bounds,
#    video_bitrate/audio_bitrate in bit/s. Default: high 720p, mid 406p, low 270p; see docs/LIVE.md.
#  - LIVE_PUBLIC_HLS_BASE_URL: override for a proxy; otherwise RUNNER_PROTOCOL://RUNNER_HOST:{port}/hls
#    {port} is the actual worker port; {instance_id} is its zero-based index, including VOD workers.
#  - LIVE_HLS_DIRECTORY: absolute output root (default: /dev/shm/hls); accepts {instance_id}
#    Each session has a UUID subdirectory. Size /dev/shm for all concurrent streams.
#  - LIVE_MEDIAMTX_API_URL: private Runner Control API (default: http://127.0.0.1:10997)
#  - LIVE_MEDIAMTX_API_USER: Control API account (default: control)
# Codec, presets, frame rate, GOP, HLS timing and recovery limits are internal defaults.
# See docs/PARAMETERS.md for their fixed values; they are not environment settings.
# LIVE_TRANSCODER=cpu
# LIVE_CPU_FALLBACK=true
# LIVE_NVDEC=false
# LIVE_VARIANTS=[{"name":"high","width":1280,"height":720,"video_bitrate":1100000,"audio_bitrate":128000},{"name":"mid","width":720,"height":406,"video_bitrate":560000,"audio_bitrate":96000},{"name":"low","width":480,"height":270,"video_bitrate":280000,"audio_bitrate":64000}]
# LIVE_PUBLIC_HLS_BASE_URL=https://live.univ.fr/runner-{instance_id}/hls
# LIVE_HLS_DIRECTORY=/dev/shm/hls
# LIVE_MEDIAMTX_API_URL=http://127.0.0.1:10997
# LIVE_MEDIAMTX_API_USER=control
