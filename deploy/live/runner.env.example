DEBUG=false
RUNNER_BASE_NAME=live-01
RUNNER_TOKEN=CHANGE_ME_RUNNER_TOKEN
ENCODING_TYPE=CPU
LIVE_MEDIAMTX_API_USER=control
LIVE_MEDIAMTX_API_PASSWORD=CHANGE_ME_CONTROL_PASSWORD
LIVE_UPSTREAM_RTMP_URL=rtmp://relay:CHANGE_ME_RELAY_PASSWORD@manager-media:1935
LIVE_LOCAL_RTMP_URL=rtmp://transcoder:CHANGE_ME_READ_PASSWORD@runner-media:1935
LIVE_PUBLIC_HLS_BASE_URL=https://live.univ.fr/hls
# Optional Esup-Pod broadcaster synchronization; configure all three together.
# LIVE_POD_URL=https://pod.univ.fr
# LIVE_POD_USERNAME=CHANGE_ME_POD_API_USERNAME
# LIVE_POD_PASSWORD=CHANGE_ME_POD_API_PASSWORD
LIVE_TRANSCODER=cpu
LIVE_CPU_FALLBACK=true
LOG_DIR=/var/log/esup-runner
